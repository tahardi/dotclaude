{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 365,
  "env": {
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "NODE_USE_ENV_PROXY": "1",
    "DISABLE_UPDATES": "1",
    "DO_NOT_TRACK": "1",
    "CLAUDE_MEM_TELEMETRY": "false",
    "CLAUDE_MEM_TELEMETRY_ERRORS": "false",
    "EXPO_SKILLS_TELEMETRY": "0"
  },
  "permissions": {
    "allow": [
      "Bash(anchorhold *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(sudo *)",
      "Bash(mkfs *)",
      "Bash(dd *)",
      "Bash(wget *|bash*)",
      "Bash(wget *| bash*)",
      "Bash(git push --force*)",
      "Bash(git push *--force*)",
      "Bash(git reset --hard*)",
      "Edit(~/.bashrc)",
      "Edit(~/.zshrc)",
      "Edit(~/.ssh/**)",
      "Edit(.git/hooks/)",
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.git-credentials)",
      "Read(~/.docker/config.json)",
      "Read(~/.kube/**)",
      "Read(~/.npmrc)",
      "Read(~/.npm/**)",
      "Read(~/.pypirc)",
      "Skill(caveman:caveman-setup)",
      "Skill(caveman:caveman-discover)",
      "Skill(caveman:caveman-evidence-review)",
      "Skill(caveman:caveman-manage)",
      "Skill(caveman:caveman-optimize)",
      "Skill(claude-mem:cloud-sync)"
    ]
  },
  "model": "opus",
  "enableAllProjectMcpServers": false,
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "printf '\\a'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "printf '\\a'",
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "CMD=$(jq -r '.tool_input.command'); if echo \"$CMD\" | grep -qE 'git[[:space:]]+push[[:space:]].*([[:space:]]|:|/|+)(main|master)([[:space:]]|$)'; then echo 'BLOCKED: Use feature branches, not direct push to main' >&2; exit 2; fi"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '\"[\" + (now | todate) + \"] \" + .tool_input.command' >> ~/.claude/bash-commands.log"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "caveman@caveman": true,
    "ponytail@ponytail": true,
    "claude-mem@thedotmack": true,
    "gh-cli@trailofbits": true,
    "expo@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "trailofbits": {
      "source": {
        "source": "github",
        "repo": "trailofbits/skills"
      }
    },
    "superpowers-dev": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers"
      }
    },
    "thedotmack": {
      "source": {
        "source": "github",
        "repo": "thedotmack/claude-mem"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    }
  },
  "outputStyle": "default",
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [
      "git worktree remove *",
      "git worktree prune",
      "git branch -D *",
      "gh pr merge *"
    ],
    "failIfUnavailable": true,
    "filesystem": {
      "allowWrite": [
        "~/Documents/code/wts",
        "~/Documents/code/dig-days/.git",
        "~/Documents/code/dotclaude/.git",
        "~/Documents/code/halo/.git",
        "~/Documents/code/health-value-dashboard/.git",
        "~/Documents/code/little-things/.git",
        "~/Documents/code/maple/.git",
        "~/Documents/code/xena/.git",
        "~/Documents/code/c/bearclave-hsm/.git",
        "~/Documents/code/go/bearclave/.git",
        "~/Documents/code/go/bearclave-chain/.git",
        "~/Documents/code/go/bearclave-contracts/.git",
        "~/Documents/code/go/bearclave-examples/.git",
        "~/Documents/code/go/bearclave-foundry/.git",
        "~/Documents/code/go/bearclave-tf/.git",
        "~/Documents/code/go/pluckmd/.git",
        "~/Documents/code/go/template/.git",
        "~/Documents/code/rust/bearclave-zkvm/.git"
      ]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "taylorantoniohardin.atlassian.net"
      ]
    }
  },
  "alwaysThinkingEnabled": true,
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "preferredNotifChannel": "terminal_bell"
}
